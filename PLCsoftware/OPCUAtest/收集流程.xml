    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A00_initialization_初始化">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">R_TRIG[1](CLK:=%MX2005.5 , Q=&gt; );  //泵空闲中

//初始化流程
CASE 初始化STEP OF
	0:
		收集下压气缸手动:=FALSE;
		收集下压气缸自动:=FALSE;
		收集夹持气缸手动:=FALSE;
		收集夹持气缸自动:=FALSE;
		收集升降气缸手动:=FALSE;
		收集升降气缸自动:=FALSE;
		收集伸缩气缸手动:=FALSE;
		收集伸缩气缸自动:=FALSE;
		收集进液手动:=FALSE;
		收集进液自动:=FALSE;
		收集排液手动:=FALSE;
		收集排液自动:=FALSE;
		收集正压排液手动:=FALSE;
		收集正压排液自动:=FALSE;
		溶液收集瓶定位手动:=FALSE;
		收集工位允许放收集瓶:=FALSE;
		收集工位允许放收集器:=FALSE;
		收集工位允许机器人退出工位:=FALSE;
		收集工位允许机器人取收集瓶放暂存工位:=FALSE;
		收集工位允许取收集器:=FALSE;
		收集工位机器人取收集器放回暂存工位:=FALSE;
		
	
		收集工位放收集瓶完成:=FALSE;
		收集工位放收集器到工位:=FALSE;
	
		收集工位机器人退出完成:=FALSE;
		
		收集工位机器人放收集瓶到暂存工位完成:=FALSE;
		
		收集工位机器人到达收集器位置:=FALSE;

		collect_prepare_OK:=FALSE;
		collect_OK:=FALSE;
		收集工位放收集器完成:=FALSE;
		收集step:=0;
		准备step:=0;
		搬运step:=0;
		IF %MW1300=0 AND NOT 泵站位符 THEN
			泵站位符:=TRUE;
			转发转存:='/3Z0,2,2R$R';     //泵初始化指令 
			%MW1300:=LEN(STR:= 转发转存);   //发送字节数
			初始化STEP:=10;
		END_IF
	10:
		IF %MW1300=0 THEN
			转发转存:='/3Q$R';          //查询泵状态指令
			%MW1300:=LEN(STR:= 转发转存);
		END_IF
		
		IF R_TRIG[1].Q THEN
			泵站位符:=FALSE;
			泵初始化完成:=TRUE;
			初始化STEP:=0;
		END_IF
END_CASE
	
	
	
	
	
	
	
	
	
	

		

</xhtml>
          </ST>
        </body>
