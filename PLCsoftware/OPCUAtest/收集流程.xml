    <pous>
      <pou name="Collection_process_收集流程" pouType="program">
        <interface>
          <localVars>
            <variable name="准备step">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="收集step">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="TON_0">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="搬运step">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="ton3s">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="ton5s">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="stepTimer">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="R_TRIG">
              <type>
                <array>
                  <dimension lower="1" upper="5" />
                  <baseType>
                    <derived name="R_TRIG" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="泵初始化完成">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="初始化STEP">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="ton">
              <type>
                <array>
                  <dimension lower="1" upper="10" />
                  <baseType>
                    <derived name="TON" />
                  </baseType>
                </array>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// TON自复位：Q变TRUE后IN立即变FALSE，下周期复位，形成循环脉冲
ton3s(IN := bEnable AND NOT ton3s.Q, PT := T#3S);

// Q脉冲时翻转输出（Q仅维持一个周期，无需上升沿检测）
IF ton3s.Q THEN
    bOutput := NOT bOutput;
END_IF

// ── 1. 急停联锁（最高优先级）──
IF NOT 急停 THEN
    collect_Step  := 0;
    collect_Done  := FALSE;
    collect_Error := TRUE;
    collect_Busy  := FALSE;
	准备step:=0;
	收集step:=0;
	搬运step:=0;
	初始化STEP:=0;
	泵初始化完成:=FALSE;
    stepTimer(IN := FALSE, PT := T#0S);
    RETURN;
END_IF

// ── 2. 复位脉冲（用于错误恢复 / 强制清状态）──
IF collect_Reset THEN
    collect_Step  := 0;
    collect_Done  := FALSE;
    collect_Error := FALSE;
    collect_Busy  := FALSE;
    stepTimer(IN := FALSE, PT := T#0S);
    RETURN;
END_IF

// ── 3. Enable=FALSE 时清 Done（次周期复位握手）──
//    上位机收到 Done 后会拉低 collect_Enable，本段确保下一周期 Done 自动归零，
//    避免 Done 残留导致 step 0 误判。
IF NOT collect_Enable THEN
    collect_Done := FALSE;
END_IF

// ── 4. 派生 collect_Busy（写者唯一：本 POU 是唯一写者，禁止他处赋值）──
collect_Busy := (collect_Step &gt;= 10)
                    AND (collect_Step &lt;= 80)
                    AND (NOT collect_Done);






IF MODE_State=1 THEN
	CASE collect_Step OF
		0 :                      // 空闲：等待 Enable 上升
			 IF collect_Enable AND (NOT collect_Done) THEN
				collect_Step := 5;
			 END_IF
		
		5:	
		    A00_initialization_初始化();
			IF 收集平台下压气缸原点 AND 收集平台夹持气缸原点 AND 收集平台升降气缸原点 AND 收集平台推出气缸原点 AND 泵初始化完成 THEN
				collect_Step:=10;
				泵初始化完成:=FALSE;
			END_IF
			
			
				
		10:                    //就位
				A10_preparation_准备();
			IF collect_prepare_OK THEN
				collect_prepare_OK:=FALSE;
				collect_Step:=20;
			END_IF
			
			
			
		20:                    //收集    	
			A20_collect_收集();
			IF collect_OK THEN
				
				FOR i := 1 TO collect_count BY 1 DO
					;   // 占位：单次打液动作（实机替换为真实调用）
				END_FOR
				collect_OK:=FALSE;
				collect_Step:=30;
			END_IF
			
			
		30:                    //物料搬运
			A30_transport_物料搬运();
			 IF 收集工位放收集器完成 THEN
				 收集工位放收集器完成:=FALSE;
				collect_Done := TRUE;
				collect_Step:=0;
			 END_IF	
			 
			 
		90: // 故障：等待外部 collect_Reset 脉冲（已在顶部统一处理）
			collect_Error := TRUE;   // 故障态本身不动作，仅等待复位
	END_CASE
END_IF










































































































</xhtml>
          </ST>
        </body>
