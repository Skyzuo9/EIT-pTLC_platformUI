    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A20_collect_收集">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">ton[1](IN:=收集step=10,PT:=T#0.5S);
ton[2](IN:=收集step=30,PT:=T#10S);
R_TRIG[5](CLK:=%MX2005.5 , Q=&gt; );  //泵空闲中
CASE 收集step OF
	0 :
		IF collect_forward_instructions&lt;&gt;'' THEN
			收集进液自动:=TRUE;
			
			
		END_IF
		IF %MW1300=0 AND 泵站位符=FALSE  THEN
			转发转存:=collect_forward_instructions; 
			%MW1300:=LEN(STR:= 转发转存);   //发送字节数
			泵站位符:=TRUE;
			收集step:=10;
		END_IF
	10:
		IF %MW1300=0 AND ton[1].Q THEN
			转发转存:='/3Q$R';          //查询泵状态指令
			%MW1300:=LEN(STR:= 转发转存);
		END_IF
		
		
		IF R_TRIG[5].Q THEN
			泵站位符:=FALSE;
			收集step:=20;
		END_IF
	

	20:
		IF TRUE  THEN    //注射泵完成//
			转发转存:='';
			%MW300:=128;
			收集进液自动:=FALSE;
			收集排液自动:=TRUE;
			收集正压排液自动:=TRUE;
			收集计数:=收集计数+1;
			收集step:=30;
		END_IF
	30:
		IF ton[2].Q THEN
			TON_0(IN:=TRUE, PT:=T#5S , Q=&gt; , ET=&gt; );
			IF 收集计数&gt;=collect_count AND TON_0.Q THEN
				收集计数:=0;
				收集step:=40;
			ELSE
				收集排液自动:=FALSE;
				收集正压排液自动:=FALSE;
				收集step:=0;
			END_IF
		END_IF
	40:
		
			收集排液自动:=FALSE;
			收集正压排液自动:=FALSE;
			collect_OK:=TRUE;
			收集step:=0;

		

		
END_CASE</xhtml>
          </ST>
        </body>
