    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A10_preparation_准备">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">//准备工作
CASE 准备step OF	
	0:
		IF 收集平台夹持气缸原点 AND 收集平台下压气缸原点 THEN
		收集工位允许放收集器:=TRUE;
		准备step:=10;
		END_IF
	10:
		IF 收集工位放收集器到工位 THEN
			收集夹持气缸自动:=TRUE;
			收集工位允许放收集器:=FALSE;
			准备step:=20;
		END_IF
	20:
		IF 收集平台夹持气缸动点 THEN
			收集工位允许机器人退出工位:=TRUE;
			准备step:=30;
		END_IF
		
	30:
		IF 收集工位机器人退出完成 THEN
			
			收集工位机器人退出完成:=FALSE;
			收集工位允许机器人退出工位:=FALSE;
			准备step:=40;
		END_IF
	40 :
		IF 收集平台推出气缸原点 AND NOT 收集平台瓶子有无传感器 THEN
			收集伸缩气缸自动:=TRUE;
			准备step:=50;
		END_IF
	50:
		IF 收集平台推出气缸动点 THEN
			收集工位允许放收集瓶:=TRUE;
			准备step:=60;
		END_IF
	60:
	    IF 收集工位放收集瓶完成 THEN
	    	收集工位允许放收集瓶:=FALSE;
			收集工位放收集瓶完成:=FALSE;
			收集伸缩气缸自动:=FALSE;
			准备step:=70;
	    END_IF
	70:
		IF 收集平台推出气缸原点 AND 收集平台瓶子有无传感器 THEN
			收集升降气缸自动:=TRUE;
			准备step:=80;
		ELSIF 收集平台推出气缸原点 AND NOT 收集平台瓶子有无传感器 THEN
			收集伸缩气缸自动:=FALSE;
			准备step:=40;
		END_IF

	80:
		IF 收集平台升降气缸动点  THEN
			收集下压气缸自动:=TRUE;
			collect_prepare_OK:=TRUE;
			准备step:=0;
		END_IF
		
END_CASE</xhtml>
          </ST>
        </body>
