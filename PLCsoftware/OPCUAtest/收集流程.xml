    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A30_transport_物料搬运">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

CASE 搬运step OF
	0 :                     //复位气缸
		收集下压气缸自动:=FALSE;
		
		搬运step:=5;
	5:
		IF 收集平台下压气缸原点 THEN
			收集升降气缸自动:=FALSE;
			搬运step:=10;
		END_IF
	10:                    //复位伸缩气缸
		IF 收集平台升降气缸原点 THEN
			收集伸缩气缸自动:=TRUE;
			搬运step:=20;
		END_IF
	20:                    //允许机器人收集瓶
		IF 收集平台推出气缸动点 THEN
			收集工位允许机器人取收集瓶放暂存工位:=TRUE;
			搬运step:=30;
		END_IF
	30:
		IF 收集工位机器人放收集瓶到暂存工位完成 THEN
			收集工位允许机器人取收集瓶放暂存工位:=FALSE;
			收集工位机器人放收集瓶到暂存工位完成:=FALSE;
			收集伸缩气缸自动:=FALSE;
			收集工位允许取收集器:=TRUE;
			搬运step:=40;
		END_IF
	40:
		IF 收集工位机器人到达收集器位置 THEN
				收集工位机器人到达收集器位置:=FALSE;
			收集夹持气缸自动:=FALSE;
			收集工位允许取收集器:=FALSE;
			搬运step:=50;
		END_IF
	50:
		IF 收集平台夹持气缸原点 THEN
			收集工位机器人取收集器放回暂存工位:=TRUE;
			搬运step:=60;
		END_IF
	60:
		 IF 收集工位放收集器完成 THEN
		 	搬运step:=0;
		 END_IF
		
		
		

END_CASE</xhtml>
          </ST>
        </body>
