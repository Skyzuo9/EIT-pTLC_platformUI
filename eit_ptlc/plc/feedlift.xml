    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A12_feed_lower">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* 上料: 机器人吸住玻璃后, Z1 相对下降 5mm 让位 *)
CASE 上料step OF
	0:
		玻璃上料轴1ZDATE.fRelTarget:=-5.0;
		玻璃上料轴1ZDATE.xMoveRel:=TRUE;
		上料step:=10;
	10:
		IF 玻璃上料轴1ZDATE.bReMoveDone THEN
			玻璃上料轴1ZDATE.xMoveRel:=FALSE;
			上料step:=0;
			bActionDone:=TRUE;
		END_IF
END_CASE
</xhtml>
          </ST>
        </body>
        <addData>
