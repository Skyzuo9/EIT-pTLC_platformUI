    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A91_endcheck">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* DEBUG: no-jog photoelectric stable-state confirmation *)
FeedLift_L2_Step := 91;
CASE FeedLift_DebugAxis OF
	1:
		feedlift_TO(IN:=(玻璃升降光电开关1 = FeedLift_DebugExpectedFinal), PT:=T#200MS);
		IF feedlift_TO.Q THEN bActionDone:=TRUE; END_IF
	2:
		feedlift_TO(IN:=(玻璃升降光电开关2 = FeedLift_DebugExpectedFinal), PT:=T#200MS);
		IF feedlift_TO.Q THEN bActionDone:=TRUE; END_IF
ELSE
	FeedLift_L2_ErrorCode:=306;
	bActionError:=TRUE;
END_CASE</xhtml>
          </ST>
        </body>
