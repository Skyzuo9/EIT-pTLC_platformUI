    <pous>
      <pou name="FeedLift_L2" pouType="program">
        <interface>
          <localVars>
            <variable name="上料step">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="下料step">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="bActionDone">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bActionError">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="L2_StartTrig">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="feedlift_TO">
              <type>
                <derived name="TON" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* FeedLift 工位 L2 统一动作派发器
   按 FeedLift_L2_ActionCode 派发到纯设备原子动作 (不含机器人/相机/CNC 握手).
   Start 上升沿接受请求 -&gt; RUNNING 每周期调用对应原子 -&gt; bActionDone=DONE / bActionError=ERROR. *)
L2_StartTrig(CLK := FeedLift_L2_Start);

CASE FeedLift_L2_State OF
	0:  (* IDLE *)
		FeedLift_L2_Step := 0;
		IF L2_StartTrig.Q THEN
			FeedLift_L2_AcceptedSeq := FeedLift_L2_RequestSeq;
			FeedLift_L2_ActiveCode  := FeedLift_L2_ActionCode;
			FeedLift_L2_ErrorCode   := 0;
			FeedLift_L2_Retryable   := FALSE;
			bActionDone  := FALSE;
			bActionError := FALSE;
			上料step := 0;
			下料step := 0;
			CASE FeedLift_L2_ActionCode OF
				11, 12, 21, 22, 91:
					FeedLift_L2_SafeState := 0;
					FeedLift_L2_State     := 10;   (* RUNNING *)
			ELSE
				FeedLift_L2_ErrorCode    := 101;  (* 未知动作码 *)
				FeedLift_L2_Retryable    := TRUE;
				FeedLift_L2_CompletedSeq := FeedLift_L2_AcceptedSeq;
				FeedLift_L2_State        := 30;   (* REJECTED *)
			END_CASE
		END_IF

	10: (* RUNNING *)
		IF FeedLift_L2_Reset THEN FeedLift_L2_State := 0; RETURN; END_IF   (* RUNNING 中 RESET: 中止挂死动作 *)
		CASE FeedLift_L2_ActiveCode OF
			11: A11_feed_raise();
			12: A12_feed_lower();
			21: A21_unload_ready();
			22: A22_unload_bury();
			91: A91_endcheck();
		END_CASE
		IF bActionDone THEN
			bActionDone              := FALSE;
			FeedLift_L2_CompletedSeq := FeedLift_L2_AcceptedSeq;
			FeedLift_L2_State        := 20;   (* DONE *)
		ELSIF bActionError THEN              (* 设备预条件未满足 -&gt; 报错交上位机 *)
			bActionError             := FALSE;
			FeedLift_L2_Retryable    := TRUE;
			FeedLift_L2_CompletedSeq := FeedLift_L2_AcceptedSeq;
			FeedLift_L2_State        := 40;   (* ERROR; ErrorCode 由原子置 *)
		END_IF

	20, 30, 40, 50:  (* 终态: 等 Start 落沿或 Reset 回 IDLE *)
		IF (NOT FeedLift_L2_Start) OR FeedLift_L2_Reset THEN
			FeedLift_L2_State := 0;
		END_IF
END_CASE</xhtml>
          </ST>
        </body>
