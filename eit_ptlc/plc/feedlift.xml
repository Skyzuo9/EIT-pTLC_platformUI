    <data name="http://www.3s-software.com/plcopenxml/action" handleUnknown="implementation">
      <action name="A22_unload_bury">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* FeedLift unload_bury: bounded 2Z jog to make PE2 stable FALSE; reverse once if low misses *)
CASE 下料step OF
	0:
		Z2JOG_POS:=FALSE;
		Z2JOG_NEG:=FALSE;
		feedlift_TO(IN:=FALSE, PT:=T#200MS);
		IF FeedLift_2Z_SearchLowTarget &gt;= FeedLift_2Z_SearchHighTarget THEN
			FeedLift_L2_ErrorCode:=303;
			下料step:=0;
			bActionError:=TRUE;
		ELSIF 玻璃升降光电开关2 AND 玻璃升降接近开关2 THEN
			下料step:=10;
		ELSE
			feedlift_TO(IN:=TRUE, PT:=T#10S);
			IF feedlift_TO.Q THEN
				FeedLift_L2_ErrorCode:=302;
				下料step:=0;
				bActionError:=TRUE;
			END_IF
		END_IF
	10:
		Z2JOG_POS:=FALSE;
		IF NOT 玻璃升降光电开关2 THEN
			Z2JOG_NEG:=FALSE;
			下料step:=30;
		ELSIF 玻璃上料轴2ZDATE.fActPos &gt; FeedLift_2Z_SearchLowTarget THEN
			Z2JOG_NEG:=TRUE;
		ELSE
			Z2JOG_NEG:=FALSE;
			下料step:=20;
		END_IF
	20:
		Z2JOG_NEG:=FALSE;
		IF NOT 玻璃升降光电开关2 THEN
			Z2JOG_POS:=FALSE;
			下料step:=30;
		ELSIF 玻璃上料轴2ZDATE.fActPos &lt; FeedLift_2Z_SearchHighTarget THEN
			Z2JOG_POS:=TRUE;
		ELSE
			Z2JOG_POS:=FALSE;
			FeedLift_L2_ErrorCode:=305;
			下料step:=0;
			bActionError:=TRUE;
		END_IF
	30:
		Z2JOG_POS:=FALSE;
		Z2JOG_NEG:=FALSE;
		feedlift_TO(IN:=NOT 玻璃升降光电开关2, PT:=T#200MS);
		IF feedlift_TO.Q THEN
			下料step:=0;
			bActionDone:=TRUE;
		ELSIF 玻璃升降光电开关2 THEN
			IF 玻璃上料轴2ZDATE.fActPos &gt; FeedLift_2Z_SearchLowTarget THEN
				下料step:=10;
			ELSIF 玻璃上料轴2ZDATE.fActPos &lt; FeedLift_2Z_SearchHighTarget THEN
				下料step:=20;
			ELSE
				FeedLift_L2_ErrorCode:=305;
				下料step:=0;
				bActionError:=TRUE;
			END_IF
		END_IF
END_CASE</xhtml>
          </ST>
        </body>
