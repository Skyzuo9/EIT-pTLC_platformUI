      <action name="A11_feed_raise">
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* FeedLift feed_raise: bounded 1Z jog; final PE1 stable TRUE *)
CASE 上料step OF
	0:
		Z1JOG_pos:=FALSE;
		feedlift_TO(IN:=FALSE, PT:=T#200MS);
		IF FeedLift_1Z_SearchLowTarget &gt;= FeedLift_1Z_SearchHighTarget THEN
			FeedLift_L2_ErrorCode:=303;
			上料step:=0;
			bActionError:=TRUE;
		ELSIF 玻璃上料轴1ZDATE.bHomed AND 玻璃升降接近开关1 AND 上料进料传感器 AND NOT Alarm.0 THEN
			上料step:=10;
		ELSE
			feedlift_TO(IN:=TRUE, PT:=T#10S);
			IF feedlift_TO.Q THEN
				FeedLift_L2_ErrorCode:=301;
				上料step:=0;
				bActionError:=TRUE;
			END_IF
		END_IF
	10:
		feedlift_TO(IN:=FALSE, PT:=T#200MS);
		IF 玻璃升降光电开关1 THEN
			Z1JOG_pos:=FALSE;
			上料step:=20;
		ELSIF 玻璃上料轴1ZDATE.fActPos &lt; FeedLift_1Z_SearchHighTarget THEN
			Z1JOG_pos:=TRUE;
		ELSE
			Z1JOG_pos:=FALSE;
			FeedLift_L2_ErrorCode:=304;
			上料step:=0;
			bActionError:=TRUE;
		END_IF
	20:
		Z1JOG_pos:=FALSE;
		feedlift_TO(IN:=玻璃升降光电开关1, PT:=T#200MS);
		IF feedlift_TO.Q THEN
			上料step:=0;
			bActionDone:=TRUE;
		ELSIF NOT 玻璃升降光电开关1 THEN
			IF 玻璃上料轴1ZDATE.fActPos &lt; FeedLift_1Z_SearchHighTarget THEN
				上料step:=10;
			ELSE
				FeedLift_L2_ErrorCode:=304;
				上料step:=0;
				bActionError:=TRUE;
			END_IF
		END_IF
END_CASE</xhtml>
          </ST>
        </body>
